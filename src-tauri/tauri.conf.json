{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krovi",
  "mainBinaryName": "Krovi",
  "version": "0.2.0",
  "identifier": "tech.krovi.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Krovi",
        "width": 440,
        "height": 88,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Krovi contributors. MIT licensed.",
    "shortDescription": "Your everything shelf",
    "longDescription": "Krovi is a free, open-source, local-first quick-access panel that gathers daily tools into one hotkey-summoned shelf.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "startMenuFolder": "Krovi"
      }
    }
  }
}
